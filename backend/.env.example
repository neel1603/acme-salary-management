GEMINI_API_KEY=<api-key>

# Local dev default if unset: sqlite:///./acme_salary.db
# Cloud (Neon Postgres, or any other Postgres host): postgresql+psycopg://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL=sqlite:///./acme_salary.db

# Comma-separated origins allowed to call this API (CORS). Set to the deployed frontend's URL in production.
ALLOWED_ORIGINS=http://localhost:5173
